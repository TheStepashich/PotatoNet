#!/usr/bin/env node
import { fileURLToPath } from 'url'
import path from 'path'
import { createRequire } from 'module'

const require = createRequire(import.meta.url)
const tauriCli = path.join(
  path.dirname(fileURLToPath(import.meta.url)),
  '..',
  'node_modules',
  '@tauri-apps',
  'cli',
  'tauri.js'
)
require(tauriCli)
