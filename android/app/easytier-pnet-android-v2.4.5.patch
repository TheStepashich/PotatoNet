+function getCustomDns(): string | undefined {
+  const instId = networkStore.networkInstanceIds[0]
+  const cfg = networkStore.networkList.find((c) => c.instance_id === instId)
+  const dns = cfg?.dns?.trim()
+  if (!dns?.length) {
+    return undefined
+  }
+  return dns.split('/')[0]
+}
